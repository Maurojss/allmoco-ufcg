{
  "entities": {
    "restaurants": {
      "title": "Restaurants",
      "description": "Restaurantes e bares do campus UFCG",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "googleMapsUrl": { "type": "string", "maxLength": 2048 },
        "openingHours": { "type": "string", "maxLength": 120 },
        "hasStudentDiscount": { "type": "boolean" },
        "studentDiscountDetails": { "type": "string", "maxLength": 250 },
        "campusZone": { "type": "string", "maxLength": 100 },
        "pratoDoDia": { "type": "string", "maxLength": 150 },
        "coordinates": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "dishes": {
          "type": "array",
          "items": { "type": "object" }
        },
        "ratings": {
          "type": "object"
        },
        "reviews": {
          "type": "array",
          "items": { "type": "object" }
        },
        "createdAt": { "type": "number" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 120 }
      },
      "required": ["name", "openingHours"]
    }
  },
  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": "restaurants",
      "description": "Coleção de restaurantes do campus UFCG com cardápios e avaliações"
    }
  }
}
